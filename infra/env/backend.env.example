DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kuuna
REDIS_URL=redis://redis:6379/0
GATEWAY_BASE_URL=http://gateway:8090
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=kuuna-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniopassword
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=
MEDIA_PROCESSING_ENABLED=true
AGENT_MENTION_IDS=
AGENT_MENTION_ALIASES=agent,kuuna
RUNTIME_AGENT_TIMEOUT_SECONDS=300
RUNTIME_EVENT_SINK_URL=http://backend:8000/internal/runtime-events/publish
# Defaults to INTERNAL_OPS_TOKEN when unset.
# RUNTIME_EVENT_SINK_TOKEN=change-me-in-dev
RUNTIME_DOCKER_SOCKET=/var/run/docker.sock
RUNTIME_DOCKER_NETWORK=kuuna-dev_default
RUNTIME_AGENT_IMAGE=kuuna-runtime-agent-ts:dev
RUNTIME_AGENT_CONTAINER_PORT=8100
RUNTIME_TOOL_BACKEND_BASE_URL=http://backend:8000
RUNTIME_TOOL_TOKEN=
RUNTIME_CONTAINER_DATA_DIR=/runtime-data
RUNTIME_CONTAINER_DATA_VOLUME_PREFIX=kuuna-runtime-data
# Mount built Gondolin guest profile assets into lazy runtime containers.
GONDOLIN_PROFILE_ASSETS_CONTAINER_DIR=/gondolin-profiles
# GONDOLIN_PROFILE_ASSETS_HOST_DIR=/absolute/path/to/gondolin-profiles
RUNTIME_CONTAINER_EXTRA_ENV_JSON=
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=20
INTERNAL_OPS_TOKEN=change-me-in-dev
REQUIRED_ADMIN_EMAIL=admin@kuuna.ai
DASHBOARD_REQUIRED_ADMIN_PASSWORD=admin123456!
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TODO_EXPORT_ENABLED=false
TODO_EXPORT_WEBHOOK_URL=
TODO_EXPORT_TIMEOUT_SECONDS=20
AUTH_TOKEN_SECRET=dev-insecure-change-me
AUTH_TOKEN_TTL_SECONDS=3600
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_SECONDS=900
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_CONSECUTIVE=3
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
